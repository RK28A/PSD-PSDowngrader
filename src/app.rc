#include <windows.h>
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "PSD - PS5 USB Prep"
      VALUE "FileVersion", "2.1.0"
      VALUE "ProductName", "PSD"
      VALUE "ProductVersion", "2.1.0"
      VALUE "OriginalFilename", "PSD.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
